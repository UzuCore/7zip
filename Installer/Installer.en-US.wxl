  <String Id="Consent" Value="I agree to trust this certificate and enable the Windows 11 context menu." />
  <String Id="Install" Value="Install" />
  <String Id="Cancel" Value="Cancel" />
  <String Id="FileManagerShortcut" Value="7zip+α File Manager" />
